# 운영 DB — .env 로 주입. 미설정 시 운영 조회 기능만 비활성화됨.
# 0~1단계: 반드시 읽기 전용 계정. 2단계부터 전용 쓰기 계정(dataops_writer).
# 운영 DB에 테이블을 만들지 않는다 (스키마 불가침 — DML만).
# 운영 RDS 는 로컬 15432 로 터널링해 사용한다 (예: jdbc:postgresql://localhost:15432/soboro)
PROD_DB_URL=jdbc:postgresql://localhost:15432/soboro
PROD_DB_USERNAME=
PROD_DB_PASSWORD=
