# Parameter Store SecureString: /sweetgirl/prod/v2/batch/env/<NAME>
# No new GitHub Secrets. DB_URL continues to identify soboro.
DATAOPS_AUTO_APPLY_ENABLED=true
DATAOPS_AUTO_APPLY_DB_USERNAME=dataops_writer
DATAOPS_AUTO_APPLY_DB_PASSWORD=REPLACE_WITH_EXISTING_SOBORO_WRITER_PASSWORD
# DATAOPS_PROD_DB_USERNAME/PASSWORD remain the reader account.
# DATAOPS_DB_USERNAME/PASSWORD remain dataops_worker for the dataops database.
# To run collection only, explicitly set DATAOPS_AUTO_APPLY_ENABLED=false.
