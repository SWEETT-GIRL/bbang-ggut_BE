    "v0"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "Asia/Seoul",
  "refresh": "1m",
  "time": {
    "from": "now-48h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_CLOUDWATCH",
      "label": "cloudwatch",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "cloudwatch"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "AWS Region",
        "type": "textbox",
        "query": "ap-northeast-2",
        "current": {
          "text": "ap-northeast-2",
          "value": "ap-northeast-2"
        }
      },
      {
        "name": "rds_instance",
        "label": "RDS instance identifier (DB 이름 아님)",
        "type": "textbox",
        "query": "YOUR_RDS_INSTANCE_IDENTIFIER",
        "current": {
          "text": "YOUR_RDS_INSTANCE_IDENTIFIER",
          "value": "YOUR_RDS_INSTANCE_IDENTIFIER"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "CloudWatch 데이터소스가 있을 때 import · 인스턴스 전체 지표",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "상단에 실제 **RDS 인스턴스 식별자**를 입력하세요 (`soboro`/`dataops` 같은 database 이름이 아닙니다). 같은 RDS 안의 database들이 공유하는 자원입니다. datasource의 AWS 읽기 권한이 필요합니다. 일반 RDS CloudWatch 지표만 사용합니다. DB 락 대기·SQL별 부하는 별도 Database Insights나 PostgreSQL 관측이 필요합니다. 지표 부재를 0으로 해석하지 마세요."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "RDS CPU",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "수집 확인 필요"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "region": "$region",
          "dimensions": {
            "DBInstanceIdentifier": "$rds_instance"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "전체 DB 연결 수",
