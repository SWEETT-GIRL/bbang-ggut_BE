    {
      "type": "timeseries",
      "title": "합치기 비율 · 초안 쓰기 N번 → DB 반영 1번",
      "description": "dev 측정 기준 약 17:1. 1에 가까우면 치는 사람이 드물어 모을 게 없는 것이고(정상), 부하가 있는데 1이면 플러시가 너무 잦은 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(draft_write_total{job=~\"${spring_job:regex}\",instance=~\"${spring_instance:regex}\",result=\"accepted\"}[$__rate_interval])) / sum(increase(draft_flush_batch_size_count{job=~\"${spring_job:regex}\",instance=~\"${spring_instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{pool}} {{workflow}} {{step}} {{outcome}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 확인 필요",
          "color": {
            "mode": "palette-classic"
