      "targets": [
        {
          "refId": "A",
          "expr": "(time() - bbang_dataops_workflow_last_success_timestamp_seconds{job=\"dataops-workflow\",workflow=\"$workflow\"}) and (bbang_dataops_workflow_last_success_timestamp_seconds{job=\"dataops-workflow\",workflow=\"$workflow\"} > 0)",
          "legendFormat": "{{instance}} {{pool}} {{workflow}} {{step}} {{outcome}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
