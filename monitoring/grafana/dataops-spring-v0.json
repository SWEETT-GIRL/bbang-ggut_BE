      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=~\"${spring_job:regex}\",instance=~\"${spring_instance:regex}\",uri!~\"/actuator.*\"}[$__rate_interval]))",
