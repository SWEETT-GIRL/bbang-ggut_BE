{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "dataops-operations",
      "folder": "DataOps",
      "interval": "1m",
      "rules": [
        {
          "uid": "bbang-dataops-pushgateway",
          "title": "DataOpsPushgatewayUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "dfutc56whwh6of",
              "model": {
                "refId": "A",
                "expr": "(max(up{job=\"dataops-pushgateway\"}) == bool 0) or vector(1)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Pushgateway 수집 경로 이상",
            "description": "Prometheus Targets, Pushgateway, 모니터링 서버 연결을 확인한다.",
            "dashboard_url": "https://grafana.bbangmapbbang.shop/d/bbang-dataops-v0",
            "recovery_note": "Resolved는 해당 경보 조건 해제다. 업무 완료는 최근 성공 시각·종료 코드·실행 이력으로 확인한다."
          },
          "labels": {
            "service": "dataops",
            "environment": "prod",
            "severity": "warning"
          },
          "isPaused": true,
          "notification_settings": {
            "receiver": "dataops-slack",
            "group_by": [
              "grafana_folder",
              "alertname",
              "workflow"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "bbang-dataops-missing",
          "title": "DataOpsDailyRefreshMissing",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "dfutc56whwh6of",
              "model": {
                "refId": "A",
                "expr": "sum(absent(bbang_dataops_workflow_last_success_timestamp_seconds{job=\"dataops-workflow\",workflow=\"freshness-refresh\"})) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
