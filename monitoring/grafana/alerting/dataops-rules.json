              "alertname",
              "workflow"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "bbang-dataops-stale",
          "title": "DataOpsDailyRefreshStale",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "dfutc56whwh6of",
              "model": {
                "refId": "A",
                "expr": "time() - bbang_dataops_workflow_last_success_timestamp_seconds{job=\"dataops-workflow\",workflow=\"freshness-refresh\"} > bool 36 * 3600",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
