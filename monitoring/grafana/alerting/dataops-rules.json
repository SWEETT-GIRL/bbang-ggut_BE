              "model": {
                "refId": "A",
                "expr": "(bbang_dataops_workflow_last_exit_code{job=\"dataops-workflow\",workflow=~\"freshness-(baseline|refresh|public|discovery)\"} > bool 0) * (bbang_dataops_workflow_last_exit_code{job=\"dataops-workflow\",workflow=~\"freshness-(baseline|refresh|public|discovery)\"} != bool 3) * (bbang_dataops_workflow_last_exit_code{job=\"dataops-workflow\",workflow=~\"freshness-(baseline|refresh|public|discovery)\"} != bool 4)",
