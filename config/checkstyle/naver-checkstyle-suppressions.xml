<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- spotless formats empty methods as `{}` which conflicts with RightCurly(alone) rule -->
    <suppress files=".*Tests?\.java" checks="RightCurly"/>
    <!-- spotless collapses empty interface body to `{}` which conflicts with WhitespaceAround rule -->
    <suppress files=".*RequestLogRepository\.java" checks="WhitespaceAround"/>
    <!-- spotless removes the space before an annotation type body (`@interface Name{`) which conflicts with WhitespaceAround -->
    <suppress files=".*[\\/]batch[\\/]job[\\/]BatchJob\.java" checks="WhitespaceAround"/>
</suppressions>
